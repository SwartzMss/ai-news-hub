{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "report_date",
    "channel",
    "version",
    "title",
    "collected_at",
    "review_status",
    "approved_at",
    "reviewed_content_sha256",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "channel": {
      "const": "opensource"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_status": {
      "const": "approved"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "importance",
          "fact_summary",
          "analysis",
          "evidence_quote",
          "verification",
          "source"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "verification": {
                  "const": "codex_reported"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "fetched_at": {
                      "type": "null"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "fetched_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "category": {
            "type": "string",
            "enum": [
              "ai",
              "opensource",
              "developer_tools",
              "security",
              "industry",
              "social_event",
              "entertainment",
              "tech_digital",
              "sports",
              "film_animation",
              "gaming",
              "finance_consumption",
              "internet_culture",
              "lifestyle_emotion",
              "international_topic",
              "other"
            ]
          },
          "importance": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "fact_summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "analysis": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence_quote": {
            "type": "string",
            "minLength": 8,
            "maxLength": 240
          },
          "verification": {
            "enum": [
              "source_only",
              "codex_reported"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "original_url",
              "canonical_url",
              "published_at",
              "event_at",
              "fetched_at"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "original_url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "canonical_url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "published_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fetched_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "details": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "background"
                ],
                "properties": {
                  "kind": {
                    "const": "investment"
                  },
                  "background": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800
                  },
                  "metrics": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "value",
                        "unit",
                        "period",
                        "basis",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "period": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "comparison": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "basis": {
                          "enum": [
                            "actual",
                            "guidance",
                            "consensus",
                            "estimate",
                            "inference"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "supplyChain": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "segment",
                        "direction",
                        "reason",
                        "relationship"
                      ],
                      "properties": {
                        "segment": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "direction": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        },
                        "relationship": {
                          "enum": [
                            "confirmed",
                            "potential"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "investmentLogic": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800
                  },
                  "watchpoints": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    }
                  },
                  "risks": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180
                    }
                  },
                  "valuation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "name",
                        "url",
                        "supports"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "supports": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "background"
                ],
                "properties": {
                  "kind": {
                    "const": "news"
                  },
                  "background": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 800
                  },
                  "keyFacts": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "value",
                        "nature",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "period": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "nature": {
                          "enum": [
                            "confirmed",
                            "statement",
                            "reported",
                            "estimate",
                            "inference"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "timeline": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "time",
                        "precision",
                        "event",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "time": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "precision": {
                          "enum": [
                            "date",
                            "datetime",
                            "approximate"
                          ]
                        },
                        "event": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 260
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "positions": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "actor",
                        "statement",
                        "form",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "actor": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "statement": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 320
                        },
                        "form": {
                          "enum": [
                            "quote",
                            "paraphrase"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "impacts": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "description",
                        "status"
                      ],
                      "properties": {
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 320
                        },
                        "status": {
                          "enum": [
                            "observed",
                            "analysis"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "uncertainties": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "watchpoints": {
                    "type": "array",
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "name",
                        "url",
                        "supports"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048
                        },
                        "supports": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        }
                      }
                    }
                  },
                  "trendTags": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 5,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "cross_platform",
                        "single_platform",
                        "controversial",
                        "viral_video",
                        "sustained_discussion"
                      ]
                    }
                  },
                  "contentTags": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "short_video",
                        "debate",
                        "story_reversal",
                        "explainer",
                        "emotional_resonance",
                        "entertainment",
                        "not_suitable"
                      ]
                    }
                  },
                  "trendSignals": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "platform",
                        "contentType",
                        "metric",
                        "value",
                        "observedAt",
                        "evidenceType",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "platform": {
                          "type": "string",
                          "enum": [
                            "weibo",
                            "douyin",
                            "bilibili",
                            "xiaohongshu",
                            "zhihu",
                            "x",
                            "reddit",
                            "other"
                          ]
                        },
                        "contentType": {
                          "type": "string",
                          "enum": [
                            "hashtag",
                            "post",
                            "video",
                            "thread",
                            "topic_page",
                            "other"
                          ]
                        },
                        "metric": {
                          "type": "string",
                          "enum": [
                            "rank",
                            "views",
                            "likes",
                            "comments",
                            "shares",
                            "posts",
                            "discussion",
                            "other"
                          ]
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "observedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "evidenceType": {
                          "type": "string",
                          "enum": [
                            "direct",
                            "reported"
                          ]
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  },
                  "publicDiscussion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "summary",
                      "evidenceRefs"
                    ],
                    "properties": {
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "evidenceRefs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        }
                      },
                      "viewpoints": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "label",
                            "summary",
                            "sentiment",
                            "evidenceRefs"
                          ],
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "summary": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240
                            },
                            "sentiment": {
                              "type": "string",
                              "enum": [
                                "supportive",
                                "critical",
                                "concerned",
                                "mixed",
                                "humorous",
                                "neutral"
                              ]
                            },
                            "evidenceRefs": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 3,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{0,31}$"
                              }
                            }
                          }
                        }
                      },
                      "controversies": {
                        "type": "array",
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "topic",
                            "sides",
                            "evidenceRefs"
                          ],
                          "properties": {
                            "topic": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            },
                            "sides": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 3,
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 180
                              }
                            },
                            "evidenceRefs": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 3,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{0,31}$"
                              }
                            }
                          }
                        }
                      },
                      "representativeComments": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "platform",
                            "quote",
                            "evidenceRefs"
                          ],
                          "properties": {
                            "platform": {
                              "type": "string",
                              "enum": [
                                "weibo",
                                "douyin",
                                "bilibili",
                                "xiaohongshu",
                                "zhihu",
                                "x",
                                "reddit",
                                "other"
                              ]
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240
                            },
                            "evidenceRefs": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 3,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^[a-z][a-z0-9-]{0,31}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "contentSuitability": {
                    "type": "string",
                    "enum": [
                      "recommended",
                      "not_recommended"
                    ]
                  },
                  "contentReason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 320
                  },
                  "contentAngles": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "angle",
                        "suggestedTitle",
                        "hook",
                        "corePoints",
                        "evidenceRefs"
                      ],
                      "properties": {
                        "angle": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 180
                        },
                        "suggestedTitle": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "hook": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 180
                        },
                        "corePoints": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 180
                          }
                        },
                        "evidenceRefs": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 3,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,31}$"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "overview",
                  "evidence"
                ],
                "properties": {
                  "kind": {
                    "const": "project"
                  },
                  "overview": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "change": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "summary",
                      "evidenceRefs"
                    ],
                    "properties": {
                      "summary": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "type": {
                        "enum": [
                          "release",
                          "feature",
                          "technical",
                          "community"
                        ]
                      },
                      "publishedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      },
                      "evidenceRefs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{0,31}$"
                        }
                      }
                    }
                  },
