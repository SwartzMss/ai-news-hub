# Local network configuration, alongside .env.
# Copy with: cp -n network.env.example network.env && chmod 600 network.env
# Edit network.env, then run: sudo bash scripts/service.sh restart
# The service installer detects project-root network.env during installation.

# Uncomment the proxy entries and replace the example address with your endpoint.
# An HTTP proxy URL can be used for both HTTP and HTTPS destinations.
# Keep uppercase and lowercase aliases consistent when editing by hand.
# HTTP_PROXY='http://proxy.example:8080'
# http_proxy='http://proxy.example:8080'
# HTTPS_PROXY='http://proxy.example:8080'
# https_proxy='http://proxy.example:8080'

NO_PROXY='localhost,127.0.0.1,::1'
no_proxy='localhost,127.0.0.1,::1'

# Optional custom certificate authority file for Node.js clients.
# NODE_EXTRA_CA_CERTS='/absolute/path/company-ca.pem'
