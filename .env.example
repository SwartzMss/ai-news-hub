# Linux Backend bootstrap only. Copy to .env; never commit the real .env.
# Configure Codex, execution limits, GitHub and admin password in /admin/.
# First start creates a private DATA_DIR/setup-code for one-time initialization.
AI_NEWS_HUB_HOST=127.0.0.1
AI_NEWS_HUB_PORT=3000
AI_NEWS_HUB_DATA_DIR=/var/lib/ai-news-hub
