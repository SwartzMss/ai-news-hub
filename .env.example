# Linux Backend. Copy to .env for local development; never commit the real .env.
# Use an absolute, private directory owned by the non-root service account (0700).
AI_NEWS_HUB_DATA_DIR=/var/lib/ai-news-hub
AI_NEWS_HUB_HOST=127.0.0.1
AI_NEWS_HUB_PORT=3000
AI_NEWS_HUB_LOG_LEVEL=info

# Empty/unset token disables all /api management endpoints; /health stays public.
# Generate locally with: openssl rand -hex 32
# Store the real token only in the private .env or systemd environment file.
AI_NEWS_HUB_ADMIN_TOKEN=
AI_NEWS_HUB_CODEX_BIN=codex
# AI_NEWS_HUB_MODEL=your-available-model
AI_NEWS_HUB_RUN_TIMEOUT_MS=120000
AI_NEWS_HUB_CONCURRENCY=1
AI_NEWS_HUB_MAX_QUEUE=20

# Optional GitHub archive target: ALL THREE must be set, otherwise publishing is disabled.
# Use a dedicated archive branch/repository; create the branch before publishing.
# Fine-grained PAT or runtime GitHub App token: selected repository, Contents read/write only.
# Never put this token in Codex configuration or any VITE_* variable.
AI_NEWS_HUB_GITHUB_REPOSITORY=
AI_NEWS_HUB_GITHUB_BRANCH=
AI_NEWS_HUB_GITHUB_TOKEN=
