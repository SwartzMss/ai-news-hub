# Install as /etc/ai-news-hub/codex-probe.env, mode 0600, owned by root.
# Confirm these absolute paths on the target host; no shell expansion is performed.
CODEX_BIN=/usr/local/bin/codex
PROBE_CWD=/var/lib/ai-news-hub/probe-work
PROBE_TIMEOUT_MS=90000
# Optional: choose an available model explicitly; otherwise use Codex configuration.
# CODEX_MODEL=your-available-model
